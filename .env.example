# Copy to .env and fill in. Never commit .env.

# Database (local Docker default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spotwise

# Data sources
ENTSOE_TOKEN=                 # from transparency.entsoe.eu (leave empty to use porssisahko fallback)
PRICE_AREA=FI
VAT_RATE=0.255                # Finland, electricity
TIMEZONE=Europe/Helsinki

# LLM (agent + judge)
ANTHROPIC_API_KEY=
LLM_MODEL=                    # pick a current small/cheap Claude model for dev; check docs.claude.com
LLM_TEMPERATURE=0
JUDGE_MODEL=                  # can be the same or a stronger model

# Tracing (optional; tracing is off if empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API
CORS_ORIGINS=http://localhost:5173
CHAT_RATE_LIMIT_PER_MIN=20

# Evals
EVAL_NOW=2025-11-15T10:00:00+02:00
EVAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spotwise_eval

# Frontend (web/.env)
# VITE_API_URL=http://localhost:8000
